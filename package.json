{
  "name": "deckory",
  "description": "A code-native presentation system for structured, validated and visually expressive decks.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KanzuXHorizon/Deckory.git"
  },
  "homepage": "https://github.com/KanzuXHorizon/Deckory#readme",
  "keywords": [
    "presentations",
    "slides",
    "typescript",
    "nextjs",
    "presentation-engine",
    "data-visualization"
  ],
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm --filter @deckory/present dev",
    "build": "pnpm --filter @deckory/present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
